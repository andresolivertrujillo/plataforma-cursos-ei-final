# Copia este archivo como .env y reemplaza todos los valores de ejemplo.
# Nunca subas el archivo .env ni credenciales reales a GitHub.

# Puerto local de la API.
PORT=4000

# Conexion a MongoDB. Reemplaza usuario, contrasena y cluster.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/plataforma_cursos

# Configuracion de autenticacion JWT.
JWT_SECRET=REEMPLAZAR_POR_UNA_CLAVE_SEGURA
JWT_EXPIRES_IN=1d

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# Credenciales ficticias utilizadas exclusivamente por el script seed.
SEED_ADMIN_NAME=Administrador de prueba
SEED_ADMIN_EMAIL=admin_prueba@ejemplo.com
SEED_ADMIN_PASSWORD=CAMBIAR_CONTRASENA_ADMIN
SEED_STUDENT_NAME=Estudiante de prueba
SEED_STUDENT_EMAIL=estudiante_prueba@ejemplo.com
SEED_STUDENT_PASSWORD=CAMBIAR_CONTRASENA_ESTUDIANTE
