# Puerto donde corre la API
PORT=4000

# Cadena de conexion a MongoDB Atlas (NO subir la real)
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/plataforma_cursos?retryWrites=true&w=majority

# Secreto para firmar los JWT (usar una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=1d

# Origenes permitidos por CORS (separados por coma), ej. las URLs de Vercel
CORS_ORIGINS=http://localhost:5173,http://localhost:4200,http://localhost:3000

# Credenciales ficticias del seed. Cambia todos estos valores antes de ejecutarlo.
SEED_ADMIN_NAME=Administrador de prueba
SEED_ADMIN_EMAIL=admin_prueba@ejemplo.com
SEED_ADMIN_PASSWORD=CAMBIAR_CONTRASENA_ADMIN
SEED_STUDENT_NAME=Estudiante de prueba
SEED_STUDENT_EMAIL=estudiante_prueba@ejemplo.com
SEED_STUDENT_PASSWORD=CAMBIAR_CONTRASENA_ESTUDIANTE
