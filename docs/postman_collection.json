{
  "info": {
    "name": "Plataforma de Cursos - API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "studentEmail", "value": "" },
    { "key": "studentPassword", "value": "" },
    { "key": "courseId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Register (estudiante)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/register",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Nuevo Estudiante\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}" }
      }
    },
    {
      "name": "Auth - Login (guarda token)",
      "event": [{ "listen": "test", "script": { "exec": ["const d = pm.response.json();", "if (d.token) pm.collectionVariables.set('token', d.token);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}" }
      }
    },
    {
      "name": "Auth - Login ADMIN (guarda adminToken)",
      "event": [{ "listen": "test", "script": { "exec": ["const d = pm.response.json();", "if (d.token) pm.collectionVariables.set('adminToken', d.token);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }
      }
    },
    {
      "name": "Courses - Listar (publico)",
      "request": { "method": "GET", "url": "{{baseUrl}}/courses" }
    },
    {
      "name": "Courses - Crear (admin)",
      "event": [{ "listen": "test", "script": { "exec": ["const d = pm.response.json();", "if (d._id) pm.collectionVariables.set('courseId', d._id);"] } }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/courses",
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Curso de prueba\",\n  \"description\": \"Descripcion\",\n  \"category\": \"General\",\n  \"instructor\": \"Docente\",\n  \"credits\": 3,\n  \"capacity\": 20,\n  \"price\": 0\n}" }
      }
    },
    {
      "name": "Courses - Actualizar (admin)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/courses/{{courseId}}",
        "body": { "mode": "raw", "raw": "{\n  \"price\": 99\n}" }
      }
    },
    {
      "name": "Enrollments - Inscribirse (estudiante)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/enrollments",
        "body": { "mode": "raw", "raw": "{\n  \"courseId\": \"{{courseId}}\"\n}" }
      }
    },
    {
      "name": "Enrollments - Mis inscripciones",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/enrollments/mine"
      }
    },
    {
      "name": "Users - Listar (admin)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/users"
      }
    },
    {
      "name": "Courses - Eliminar (admin)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/courses/{{courseId}}"
      }
    }
  ]
}
